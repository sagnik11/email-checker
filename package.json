{
  "name": "email-validation-service",
  "version": "0.2.0",
  "description": "Generic email validation backend and CLI",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "email-validator": "dist/bin/email-validator.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-data-assets.js",
    "dev": "tsx src/server.ts",
    "dev:worker": "tsx src/worker/run.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker/run.js",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "amqplib": "^0.10.7",
    "commander": "^13.1.0",
    "csv-stringify": "^6.6.0",
    "disposable-email-domains": "^1.0.62",
    "express": "^4.21.2",
    "isemail": "^3.2.0",
    "mailchecker": "^6.0.18",
    "pg": "^8.14.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "socks": "^2.8.7",
    "toml": "^3.0.0"
  }
}
